{
  "name": "@landing-page-generator/fe",
  "private": true,
  "scripts": {
    "install:all": "bash ./scripts/install-workspace.sh all",
    "install:web": "bash ./scripts/install-workspace.sh web",
    "install:landing": "bash ./scripts/install-workspace.sh landing",
    "install:ui": "bash ./scripts/install-workspace.sh ui",
    "install:packages": "bash ./scripts/install-workspace.sh packages",
    "dev:web": "pnpm build:pkg && pnpm --filter landing-page-generator-fe dev",
    "dev:landing": "pnpm build:pkg && pnpm --filter landing-page-web dev",
    "build": "pnpm build:pkg && pnpm --filter landing-page-generator-fe build && pnpm --filter landing-page-web build",
    "build:pkg": "pnpm --filter \"./packages/*\" run build",
    "lint": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" lint"
  },
  "devDependencies": {
    "oxfmt": "^0.61.0"
  },
  "packageManager": "pnpm@11.7.0"
}
